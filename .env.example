# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_URL=https://your-project.supabase.co

# Public frontend API endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# OpenAI (English ASR/TTS)
OPENAI_API_KEY=your-openai-key

# Google
GOOGLE_TRANSLATE_API_KEY=your-google-translate-key
GOOGLE_GEMINI_API_KEY=your-gemini-key

# WhatsApp Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=any-custom-string-you-choose
WHATSAPP_APP_SECRET=your-meta-app-secret

# Backend
BACKEND_URL=http://localhost:8000
BACKEND_INTERNAL_SECRET=replace-with-a-long-random-shared-secret
CORS_ORIGINS=http://localhost:3000

# Optional local webhook tunneling
NGROK_TOKEN=your-ngrok-token
